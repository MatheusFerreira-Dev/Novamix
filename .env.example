# Copie para .env.local (local) ou cadastre no Vercel → Settings → Environment Variables.
# Estas variáveis são lidas só no BUILD (não vão para o navegador) e NÃO são segredos.

# URL pública oficial do site, sem barra no final. Usada em canonical, Open Graph, sitemap.xml, robots.txt e JSON-LD.
SITE_URL=https://www.seudominio.com.br

# (opcional) código de verificação do Google Search Console por meta tag
GOOGLE_SITE_VERIFICATION=
